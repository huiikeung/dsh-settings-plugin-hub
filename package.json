{
  "name": "dsh-settings-plugin-hub",
  "version": "0.2.4",
  "type": "module",
  "main": "lib/index.js",
  "description": "DeepSeek Harness Web profile 插件：设置左侧栏收纳 —— 把所有第三方插件注册的 settings.section 分页收进唯一的「第三方插件」入口，按本地/非本地安装分组，并支持把想留在左侧栏的分页手工「固定」。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huiikeung/dsh-settings-plugin-hub.git"
  },
  "homepage": "https://github.com/huiikeung/dsh-settings-plugin-hub#readme",
  "bugs": {
    "url": "https://github.com/huiikeung/dsh-settings-plugin-hub/issues"
  },
  "engines": {
    "node": ">=20.3",
    "dsh": ">=0.1.6-alpha.1"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "settings",
    "sidebar"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./inventory": "./lib/inventory.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "tests",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
